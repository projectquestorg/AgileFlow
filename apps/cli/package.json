{
  "name": "agileflow",
  "version": "5.0.0-alpha.0",
  "description": "Portable workflows for coding agents: install, update, fork, and evaluate Agent Skills across Codex, Claude Code, Cursor, OpenCode, and Gemini CLI",
  "keywords": [
    "agent-skills",
    "skills",
    "codex",
    "claude-code",
    "cursor",
    "opencode",
    "gemini-cli",
    "cli",
    "workflows"
  ],
  "homepage": "https://github.com/projectquestorg/AgileFlow#readme",
  "bugs": {
    "url": "https://github.com/projectquestorg/AgileFlow/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/projectquestorg/AgileFlow.git",
    "directory": "apps/cli"
  },
  "license": "MIT",
  "author": "AgileFlow Contributors",
  "type": "module",
  "bin": {
    "agileflow": "bin/agileflow.js"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node bin/agileflow.js",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p ../../tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts",
    "test:watch": "vitest --config ../../vitest.config.ts",
    "registry:build": "tsx scripts/build-registry.ts",
    "registry:check": "tsx scripts/build-registry.ts --check",
    "schemas:build": "tsx scripts/build-schemas.ts",
    "release-gate": "npm run typecheck && npm test && npm run registry:check && npm run schemas:check && tsx src/index.ts eval --lint --catalog ../../skills",
    "prepublishOnly": "npm run release-gate && npm run build",
    "schemas:check": "tsx scripts/build-schemas.ts --check"
  },
  "dependencies": {
    "@clack/prompts": "^0.8.2",
    "@iarna/toml": "^2.2.5",
    "commander": "^12.1.0",
    "diff": "^8.0.3",
    "semver": "^7.7.3",
    "yaml": "^2.9.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "@types/semver": "^7.7.1",
    "esbuild": "^0.25.12",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

# Public origin of this deployment; /mcp, /cli, /local-control audiences derive from it.
AGILEFLOW_PUBLIC_URL=https://app.agileflow.projectquestorg.com
# Marketing site may link to the dashboard; list extra browser origins allowed to call the API (comma-separated).
AGILEFLOW_ALLOWED_ORIGINS=
# Random 32+ byte secret for signed list/content cursors.
AGILEFLOW_CURSOR_SECRET=
# Clerk instance (Dashboard > API keys). Issuer is the Frontend API URL.
CLERK_ISSUER=https://clerk.agileflow.projectquestorg.com
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_FRONTEND_API=clerk.agileflow.projectquestorg.com
CLERK_WEBHOOK_SECRET=
# First-party OAuth applications created in Clerk for the CLI and the companion.
AGILEFLOW_CLI_CLIENT_ID=
AGILEFLOW_COMPANION_CLIENT_ID=
# DATABASE_URL=postgres://...   (omit to use embedded PGlite; not for production)

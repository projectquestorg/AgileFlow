{
  "$id": "https://agileflow.dev/schemas/work/story.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "number",
      "const": 1
    },
    "type": {
      "type": "string",
      "const": "story"
    },
    "id": {
      "type": "string",
      "pattern": "^STORY-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{8}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "backlog",
        "ready",
        "in-progress",
        "in-review",
        "blocked",
        "done",
        "cancelled"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "p0",
        "p1",
        "p2",
        "p3"
      ]
    },
    "epic": {
      "type": "string",
      "pattern": "^EPIC-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{8}$"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^STORY-[0123456789ABCDEFGHJKMNPQRSTVWXYZ]{8}$"
      }
    },
    "legacy_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema",
    "type",
    "id",
    "title",
    "status"
  ],
  "additionalProperties": false
}

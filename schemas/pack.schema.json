{
  "$id": "https://agileflow.dev/schemas/pack.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^(@[a-z0-9-]+\\/)?[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "version": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "description": {
      "type": "string"
    },
    "skills": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "name",
    "version",
    "skills"
  ],
  "additionalProperties": false
}

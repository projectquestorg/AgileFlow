{
  "$id": "https://agileflow.dev/schemas/eval.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "skill": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "kind": {
      "default": "standard",
      "type": "string",
      "enum": [
        "standard",
        "adversarial"
      ]
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "invocation": {
      "default": "implicit",
      "type": "string",
      "enum": [
        "implicit",
        "explicit"
      ]
    },
    "fixture": {
      "type": "string"
    },
    "setup": {
      "type": "string"
    },
    "bin": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "assert": {
      "type": "object",
      "properties": {
        "shouldActivate": {
          "type": "boolean"
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "shouldActivate"
      ],
      "additionalProperties": false
    },
    "heldOut": {
      "type": "boolean"
    },
    "neighbor": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "enum": [
        "happy",
        "blocked",
        "failure"
      ]
    },
    "rubric": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "properties": {
              "criterion": {
                "type": "string",
                "minLength": 1
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "noCommand": {
                "type": "string",
                "minLength": 1
              },
              "output": {
                "type": "string",
                "minLength": 1
              },
              "noOutput": {
                "type": "string",
                "minLength": 1
              },
              "fileChanged": {
                "type": "string",
                "minLength": 1
              },
              "fileUnchanged": {
                "type": "string",
                "minLength": 1
              },
              "fileContains": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pattern": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "path",
                  "pattern"
                ],
                "additionalProperties": false
              },
              "run": {
                "type": "string",
                "minLength": 1
              },
              "exitCode": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "maxFilesChanged": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "forbid": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "output": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "interaction": {
      "type": "object",
      "properties": {
        "ambiguity": {
          "type": "string",
          "enum": [
            "choice",
            "missing-information",
            "repository-answerable"
          ]
        },
        "decision": {
          "type": "string",
          "minLength": 1
        },
        "success": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "ambiguity",
        "decision",
        "success"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "skill",
    "prompt",
    "assert"
  ],
  "additionalProperties": false
}

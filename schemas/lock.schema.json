{
  "$id": "https://agileflow.dev/schemas/lock.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "resolved": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "resolved": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "ref": {
            "type": "string"
          },
          "integrity": {
            "type": "string",
            "pattern": "^sha256-[A-Za-z0-9+/]{43}=$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "renderedHash": {
            "type": "string",
            "minLength": 1
          },
          "hashVersion": {
            "type": "integer",
            "minimum": 2,
            "maximum": 2
          },
          "executables": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "renderer": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "questionOverlay": {
            "type": "string",
            "enum": [
              "prefer",
              "minimize"
            ]
          },
          "activation": {
            "default": "auto",
            "type": "string",
            "enum": [
              "auto",
              "manual"
            ]
          },
          "ownership": {
            "default": "managed",
            "type": "string",
            "enum": [
              "managed",
              "local"
            ]
          },
          "enabled": {
            "type": "boolean",
            "const": false
          }
        },
        "required": [
          "source",
          "version",
          "path"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "version"
  ],
  "additionalProperties": {}
}

{
  "$id": "https://agileflow.dev/schemas/lock.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "resolved": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "resolved": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "ref": {
            "type": "string"
          },
          "integrity": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "renderedHash": {
            "type": "string",
            "minLength": 1
          },
          "activation": {
            "default": "auto",
            "type": "string",
            "enum": [
              "auto",
              "manual"
            ]
          },
          "ownership": {
            "default": "managed",
            "type": "string",
            "enum": [
              "managed",
              "local"
            ]
          },
          "enabled": {
            "type": "boolean",
            "const": false
          }
        },
        "required": [
          "source",
          "version",
          "path"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "version"
  ],
  "additionalProperties": {}
}

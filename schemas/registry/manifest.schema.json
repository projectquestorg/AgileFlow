{
  "$id": "https://agileflow.dev/schemas/registry/manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "number",
      "const": 1
    },
    "packages": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "string",
          "pattern": "^sha256-[A-Za-z0-9+/]+=*$"
        }
      }
    }
  },
  "required": [
    "schema",
    "packages"
  ]
}
